{
  "name": "my-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "my-workspace",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@myworkspace/cli-tool": {
      "resolved": "packages/cli-tool",
      "link": true
    },
    "node_modules/@myworkspace/math-utils": {
      "resolved": "packages/math-utils",
      "link": true
    },
    "packages/cli-tool": {
      "name": "@myworkspace/cli-tool",
      "version": "1.0.0",
      "dependencies": {
        "@myworkspace/math-utils": "^1.0.0"
      }
    },
    "packages/math-utils": {
      "name": "@myworkspace/math-utils",
      "version": "1.0.0"
    }
  }
}
